{
  "name": "delivereats",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=@delivereats/api --filter=@delivereats/admin",
    "start:api": "pnpm --filter @delivereats/api start",
    "start:api:pm2": "pnpm --filter @delivereats/api pm2:start:prod",
    "start:admin": "pnpm --filter @delivereats/admin start",
    "start:admin:pm2": "pnpm --filter @delivereats/admin pm2:start",
    "seed": "pnpm --filter @delivereats/api seed",
    "seed:admin": "pnpm --filter @delivereats/api seed:admin",
    "seed:categories": "pnpm --filter @delivereats/api seed:categories",
    "seed:vendor-products": "pnpm --filter @delivereats/api seed:vendor-products",
    "seed:all": "pnpm --filter @delivereats/api seed:all",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18"
  }
}
